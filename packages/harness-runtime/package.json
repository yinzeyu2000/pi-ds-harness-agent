{
	"name": "@pi-ds/harness-runtime",
	"version": "0.1.0",
	"description": "Composable runtime and plugin microkernel for pi+ds harness agent",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./plugin-sdk": {
			"types": "./dist/plugin-sdk.d.ts",
			"import": "./dist/plugin-sdk.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.84.4",
		"@earendil-works/pi-agent-core": "^0.84.4",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
